   "t0": 10.9,
   "t1": 15.6,
   "y": 516,
   "size": 19
  },
  {
   "type": "sub",
   "en": "Cities lit up with a billion tiny switches.",
   "zh": "城市里，亮起了亿万个小开关。",
   "text": "城市里亮",
   "t0": 15.9,
   "t1": 21.6,
   "y": 516,
   "size": 19
  },
  {
   "type": "sub",
   "en": "And now it walks beside us.",
   "zh": "如今，它走在我们身边。",
   "text": "如今它走",
